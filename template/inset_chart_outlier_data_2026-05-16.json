  "title": {
    "anchor": "start",
    "align": "left",
    "text": "Deneb Inset Chart - Outlier Data",
    "subtitle": [
      "Countries by Area (selected countries only)",
      "Data Source: Wikipedia, 2025-05-26",
      "URL: https://en.wikipedia.org/wiki/List_of_countries_and_dependencies_by_area"
    ],
    "offset": 20,
    "font": "Segoe UI",
    "fontSize": 24,
    "fontWeight": "bold",
    "fontStyle": "italic",
    "color": "#4A4A4A",
    "subtitleFont": "Segoe UI",
    "subtitleFontSize": 16,
    "subtitleFontWeight": "normal",
    "subtitleFontStyle": "italic",
    "subtitleColor": "#969696"
  },
  // standard Power BI dataset
  "data": {
    "name": "dataset"
  },
  "transform": [
    // assign internal field to identify dataset
    {
      "calculate": "1",
      "as": "_DEV_ID"
    },
    // assign an internal field name to the dataset field
    {
      "calculate": "datum['__1__']",
      "as": "_category"
    },
    {
      "calculate": "datum['__2__']",
      "as": "_category_value"
    },
    // determine the rank for use in the display order    
    {
      "window": [
        {
          "op": "rank",
          "as": "_category_rank"
        }
      ],
      "sort": [
        {
          "field": "_category_value",
          "order": "descending"
        }
      ]
    },
    // set a composite label
    {
      "calculate": "pad( datum['_category_rank'], 2, '0', 'left' ) + '-' + datum['_category']",
      "as": "_category_rank_category_name_label"
    },
    // get the min and max data values
    {
      "joinaggregate": [
        {
          "op": "max",
          "field": "_category_value",
          "as": "_max_category_value"
        },
        {
          "op": "min",
          "field": "_category_value",
          "as": "_min_category_value"
        }
      ]
    },
    {
      "calculate": "datum['_max_category_value'] * 0.8",
      "as": "_normal_threshold_value"
    },
    {
      "calculate": "datum['_category_value'] < datum['_normal_threshold_value']",
      "as": "_below_normal_threshold_value"
    },
    {
      "calculate": "if( datum['_category_rank'] == ( _outliers + 1 ), datum['_category_value'], null )",
      "as": "_inset_non_outlier_category_value"
    },
    {
      "joinaggregate": [
        {
          "op": "max",
          "field": "_inset_non_outlier_category_value",
          "as": "_max_inset_non_outlier_category_value"
        }
      ]
    },
    {
      "calculate": "if( datum['_category_rank'] <= _outliers, datum['_max_inset_non_outlier_category_value'] + 5000, datum['_category_value'] )",
      "as": "_inset_chart_category_value"
    },
    {
      "calculate": "datum['_max_inset_non_outlier_category_value'] * 0.8",
      "as": "_inset_threshold_value"
    },
    {
      "calculate": "datum['_category_value'] < datum['_inset_threshold_value']",
      "as": "_below_inset_threshold_value"
    }
  ],
  "params": [
    {
      "name": "_bar_colour",
      "expr": "pbiColor(2)"
    },
    // use an expression for the gradient colour to permit use of a dynamic colour
    {
      "name": "_bar_gradient_colour",
      "expr": "{x1: 0, y0: 0, x2: 1, y2: 0, gradient: 'linear', stops: [{ offset: 0, color: _bar_colour }, { offset: 1, color: 'white' }]}"
    },
    {
      "name": "_inset_chart_upper_value",
      "expr": "data('data_0')[_outliers]['_inset_chart_category_value']"
    },
    // NOTE: add 5000 to enforce roundUp
    {
      "name": "_inset_chart_upper_value2",
      "expr": "toNumber( format( _inset_chart_upper_value + 5000, '.2r' ) )"
    },
    {
      "name": "_outliers",
      "value": 2,
      "bind": {
        "input": "range",
        "min": 1,
        "max": 5,
        "step": 1,
        "name": "Outliers: "
      }
    }
  ],
  "spacing": 10,
  "hconcat": [
    {
      "name": "NORMAL_CHART",
      // text and position only; formatting done in "config\title"
      "title": {
        "text": "Normal Chart",
        "subtitle": "Full Range",
        "offset": 4
      },
      // adjust to suit desired visual size
      // Future Development: investigate how to use an expression of width here
      "width": 450,
      "height": 470,
      "encoding": {
        "y": {
          "field": "_category_rank_category_name_label",
          "type": "nominal",
          "sort": "-x",
          "axis": {
            "title": null,
            "offset": 4,
            "labelExpr": "slice( datum.value, 3, 100 )"
          }
        },
        "x": {
          "field": "_category_value",
          "type": "quantitative",
          "axis": {
            "title": null,
            "labelFlush": false,
            "formatType": "pbiFormat",
            "format": "0,,.# M"
          }
        }
      },
      "layer": [
        {
          "name": "NORMAL_BAR",
          "mark": {
            "type": "bar",
            "color": {
              "expr": "_bar_colour"
            },
            "style": "_normal_bar_style",
            // *** DEV ONLY ***
            "tooltip": {
              "content": "data"
            }
          }
        },
        {
          "name": "NORMAL_DATA_LABEL",
          "mark": {
            "type": "text",
            "align": {
              "expr": "if( datum['_below_normal_threshold_value'] == true, 'left', 'right' )"
            },
            "xOffset": {
              "expr": "if( datum['_below_normal_threshold_value'] == true, 4, -4 )"
            },
            "color": {
              "expr": "if( datum['_below_normal_threshold_value'] == true, 'black', 'white' )"
            },
            "style": "_normal_data_label_text_style"
          },
          "encoding": {
            "text": {
              "field": "_category_value",
              "type": "quantitative",
              "formatType": "pbiFormat",
              // adjust Power BI format string to suit dataset 
              "format": "#,. K"
            }
          }
        }
      ]
    },
    {
      "name": "INSET_CHART",
      // text and position only; formatting done in "config\title"
      "title": {
        "text": "Inset Chart",
        "subtitle": "Truncated Range",
        "offset": 0
      },
      // adjust to suit desired visual size
      // Future Development: investigate how to use an expression of width here
      "width": 450,
      "height": 470,
      "encoding": {
        "y": {
          "field": "_category_rank_category_name_label",
          "type": "nominal",
          "sort": "-x",
          "axis": null
        },
        "x": {
          "field": "_category_value",
          "type": "quantitative",
          "axis": {
            "title": null,
            "labelFlush": false,
            "formatType": "pbiFormat",
            // adjust Power BI format string to suit dataset 
            "format": "0,.# K"
          },
          "scale": {
            "domain": [
              0,
              // adjust scale to suit dataset
              {
                "expr": "_inset_chart_upper_value2 + 50000"
              }
            ]
          }
        }
      },
      "layer": [
        {
          "name": "INSET_BAR",
          "mark": {
            "type": "bar",
            "color": {
              "expr": "_bar_colour"
            },
            "height": {
              "band": 0.8
            },
            // restrict the domain to the specified range
            "clip": true,
            "style": "_inset_bar_style",
            // *** DEV ONLY ***
            "tooltip": {
              "content": "data"
            }
          }
        },
        {
          "name": "INSET_GRADIENT_BAR",
          "transform": [
            // assign internal field to identify dataset
            {
              "calculate": "2",
              "as": "_DEV_ID"
            },
            {
              "filter": "datum['_category_rank'] <= _outliers"
            }
          ],
          "mark": {
            "type": "bar",
            "color": {
              "expr": "_bar_gradient_colour"
            },
            "height": {
              "band": 0.8
            },
            "style": "_inset_gradient_bar_style"
          },
          "encoding": {
            // adjust to suit dataset
            "x": {
              "datum": {
                "expr": "_inset_chart_upper_value"
              }
            },
            // adjust to suit dataset
            "x2": {
              "datum": {
                "expr": "_inset_chart_upper_value2 + 50000"
              }
            }
          }
        },
        {
          "name": "INSET_DATA_LABEL",
          "transform": [
            // assign internal field to identify dataset
            {
              "calculate": "3",
              "as": "_DEV_ID"
            },
            {
              "calculate": "if( datum['_category_rank'] > _outliers, true, false )",
              "as": "_above_outlier_rank"
            }
          ],
          "mark": {
            "type": "text",
            "align": {
              "expr": "if( datum['_above_outlier_rank'] == true, 'left', 'right' )"
            },
            "xOffset": {
              "expr": "if( datum['_above_outlier_rank'] == true, 4, -4 )"
            },
            "color": {
              "expr": "if( datum['_above_outlier_rank'] == true, 'black', 'white' )"
            },
            "style": "_inset_data_label_text_style"
          },
          "encoding": {
            "text": {
              "field": "_category_value",
              "type": "quantitative",
              "formatType": "pbiFormat",
              // adjust Power BI format string to suit dataset
              "format": "0,. K"
            },
            "x": {
              "field": "_inset_chart_category_value",
              "type": "quantitative"
            }
          }
        }
      ]
    }
  ]
}
