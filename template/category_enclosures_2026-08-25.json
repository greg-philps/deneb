  "title": {
    "anchor": "start",
    "align": "left",
    "offset": 20,
    "text": "Deneb Category Enclosures",
    "subtitle": "Synthetic Survey Data"
  },
  // standard Power BI dataset  
  "data": {
    "name": "dataset"
  },
  "transform": [
    // assign internal names to dataset fields
    {
      "calculate": "datum['__0__']",
      "as": "_category_id"
    },
    {
      "calculate": "datum['__1__']",
      "as": "_category"
    },
    {
      "calculate": "datum['__2__']",
      "as": "_subcategory_id"
    },
    {
      "calculate": "datum['__3__']",
      "as": "_subcategory"
    },
    {
      "calculate": "datum['__4__']",
      "as": "_percent"
    },
    // compose composite id
    {
      "calculate": "( datum['_category_id'] * 100 ) + ( datum['_subcategory_id'] * 1 )",
      "as": "_composite_id"
    }
  ],
  // shared encoding to apply to all layered marks
  "encoding": {
    "y": {
      "field": "_composite_id",
      "type": "nominal",
      "axis": null
    },
    "x": {
      "field": "_percent",
      "type": "quantitative"
    }
  },
  "layer": [
    {
      "name": "CATEGORY",
      "transform": [
        {
          "joinaggregate": [
            {
              "op": "min",
              "field": "_composite_id",
              "as": "_composite_id_min"
            },
            {
              "op": "max",
              "field": "_composite_id",
              "as": "_composite_id_max"
            },
            {
              "op": "sum",
              "field": "_percent",
              "as": "_category_percent"
            }
          ],
          "groupby": [
            "_category_id"
          ]
        },
        // adjust neutral value to suit dataset
        {
          "filter": "datum['_category'] != 'Neutral'"
        },
        {
          "window": [
            {
              "op": "rank",
              "as": "_subcategory_id_rank"
            }
          ],
          "groupby": [
            "_category_id"
          ],
          "sort": [
            {
              "field": "_subcategory_id",
              "order": "ascending"
            }
          ]
        },
        {
          "filter": "datum['_subcategory_id_rank'] == 1"
        }
      ],
      "layer": [
        {
          "name": "CATEGORY_BAR",
          "mark": {
            "type": "rect",
            "yOffset": -49,
            "y2Offset": 49,
            "color": {
              "expr": "datum['_category'] == 'Positive' ? pbiColor('positive') : pbiColor('negative')"
            },
            "opacity": 0.3, // adjust opacity (transparency) as desired
            "style": "_category_bar_style"
          },
          "encoding": {
            // hard-code X values to fill container width
            "x": {
              "value": {
                "expr": "0"
              }
            },
            "x2": {
              "value": {
                "expr": "width"
              }
            },
            "y": {
              "field": "_composite_id_min"
            },
            "y2": {
              "field": "_composite_id_max"
            }
          }
        },
        {
          "name": "CATEGORY_LABEL",
          "mark": {
            "type": "text",
            "align": "center",
            "angle": 270,
            "yOffset": 50,
            "style": "_category_text_style"
          },
          "encoding": {
            "text": {
              "field": "_category"
            },
            "x": {
              "datum": -0.12
            }
          }
        },
        {
          "name": "CATEGORY_PERCENT",
          "mark": {
            "type": "text",
            "align": "right",
            "yOffset": 50,
            "style": "_category_percent_text_style"
          },
          "encoding": {
            "text": {
              "field": "_category_percent",
              "formatType": "pbiFormat",
              // adjust Power BI format string as desired
              "format": "#%"
            },
            "x": {
              "datum": 0.44
            }
          }
        }
      ]
    },
    {
      "name": "SUBCATEGORY",
      "layer": [
        {
          "name": "SUBCATEGORY_BAR",
          "transform": [
            {
              "window": [
                {
                  "op": "rank",
                  "as": "_subcategory_rank_asc"
                }
              ],
              "groupby": [
                "_category"
              ],
              "sort": [
                {
                  "field": "_subcategory_id",
                  "order": "ascending"
                }
              ]
            },
            {
              "window": [
                {
                  "op": "rank",
                  "as": "_subcategory_rank_desc"
                }
              ],
              "groupby": [
                "_category"
              ],
              "sort": [
                {
                  "field": "_subcategory_id",
                  "order": "descending"
                }
              ]
            },
            {
              "calculate": "datum['_category'] == 'Positive' ? datum['_subcategory_rank_asc'] : datum['_category'] == 'Negative' ? datum['_subcategory_rank_desc'] : 1",
              "as": "_subcategory_opacity"
            },
            {
              "calculate": "1 - ( datum['_subcategory_opacity'] * 0.4 )",
              "as": "_subcategory_opacity"
            }
          ],
          "mark": {
            "type": "bar",
            "height": {
              "band": 0.7
            },
            "color": {
              "expr": "datum['_category'] == 'Positive' ? pbiColor('positive') : datum['_category'] == 'Negative' ? pbiColor('negative') : pbiColor('neutral')"
            },
            "opacity": {
              "expr": "datum['_subcategory_opacity']"
            },
            "style": "_subcategory_bar_style"
          }
        },
        {
          "name": "SUBCATEGORY_LABEL",
          "mark": {
            "type": "text",
            "align": "right",
            "xOffset": -10,
            "style": "_subcategory_text_style"
          },
          "encoding": {
            "text": {
              "field": "_subcategory"
            },
            "x": {
              "datum": 0
            }
          }
        },
        {
          "name": "SUBCATEGORY_PERCENT",
          "mark": {
            "type": "text",
            "align": "left",
            "xOffset": 10,
            "style": "_subcategory_percent_text_style"
          },
          "encoding": {
            "text": {
              "field": "_percent",
              "formatType": "pbiFormat",
              // adjust Power BI format string as desired
              "format": "#%"
            }
          }
        }
      ]
    }
  ]
}