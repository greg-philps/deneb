  /*
  "usermeta": {
    "title": "Deneb Population Pyramid",
    "author": "Greg Philps",
    "date": "2026-10-13",
    "deneb version": "2.0.0",
    "power bi desktop version": "2.158.1304.0",
    "description": "A simple population pyramid consisting of 3 parts: a left-facing bar chart, a right-facing bar chart, and a common Y-axis; bars are coloured with Power BI theme divergent colours (max; min)",
    "notes": "",
    "template notes": "usermeta object is used by the Deneb template generation process and is thus overwritten, hence added here as a comment"
  },
  */
  "title": {
    "anchor": "start",
    "align": "left",
    "offset": 18,
    "text": "Deneb Population Pyramid",
    "subtitle": "Data Source: 2021 Canada Census"
  },
  // standard Power BI dataset 
  "data": {
    "name": "dataset"
  },
  "transform": [
    // assign internal names to dataset fields
    {
      "calculate": "datum['__dataset.0__']",
      "as": "_age_group"
    },
    {
      "calculate": "datum['__dataset.1__']",
      "as": "_age_group_id"
    },
    {
      "calculate": "datum['__dataset.2__']",
      "as": "_region"
    },
    {
      "calculate": "datum['__dataset.3__']",
      "as": "_year"
    },
    {
      "calculate": "datum['__dataset.4__']",
      "as": "_count"
    },
    {
      "calculate": "datum['__dataset.5__']",
      "as": "_sex"
    },
    // remove full country data
    {
      "filter": "datum['_region'] != 'Canada'"
    },
    // modify age group data for presentation
    {
      "calculate": "replace( replace( replace( datum['_age_group'], ' years', '' ), ' to ', '-' ), '100 and over', '>=100' )",
      "as": "_age_group_short"
    },
    // get the total province population
    {
      "joinaggregate": [
        {
          "op": "sum",
          "field": "_count",
          "as": "_region_count"
        }
      ]
    }
  ],
  "params": [
    {
      "name": "_positive_group_range_max",
      "value": 600000 // adjust to suit dataset
    },
    // use the same numerical size for negative and positive for ease of comparison
    {
      "name": "_negative_group_range_max",
      "expr": "-1 * _positive_group_range_max"
    },
    // get Power BI theme divergent colours (full and light)
    {
      "name": "_right_colour_1",
      "expr": "pbiColor('max')"
    },
    {
      "name": "_right_colour_0",
      "expr": "pbiColor('max', 0.75)" // 75% lighter
    },
    {
      "name": "_left_colour_1",
      "expr": "pbiColor('min')"
    },
    {
      "name": "_left_colour_0",
      "expr": "pbiColor('min', 0.75)" // 75% lighter
    },
    // compose the gradient expressions
    {
      "name": "_left_colour_gradient",
      "expr": "{x1: 1, y1: 0, x2: 0, y2: 0, gradient: 'linear', stops: [{ offset: 0.0, color: _left_colour_0 }, { offset: 1.0, color: _left_colour_1 }]}"
    },
    {
      "name": "_right_colour_gradient",
      "expr": "{x1: 0, y1: 1, x2: 1, y2: 1, gradient: 'linear', stops: [{ offset: 0.0, color: _right_colour_0 }, { offset: 1.0, color: _right_colour_1 }]}"
    }
  ],
  "hconcat": [
    {
      "name": "FEMALE",
      "width": 400,
      "height": 600,
      "layer": [
        {
          "name": "REGION_NAME",
          "transform": [
            // return only a single row
            {
              "filter": "datum['__row__'] == 0"
            }
          ],
          "mark": {
            "type": "text",
            "align": "left",
            "style": "_region_name_text_style"
          },
          "encoding": {
            "text": {
              "field": "_region"
            },
            "x": {
              "value": 0
            },
            "y": {
              "value": 10
            }
          }
        },
        {
          "name": "REGION_COUNT",
          "transform": [
            // return only a single row
            {
              "filter": "datum['__row__'] == 0"
            }
          ],
          "mark": {
            "type": "text",
            "align": "left",
            "style": "_region_count_text_style"
          },
          "encoding": {
            "text": {
              "field": "_region_count",
              "formatType": "pbiFormat",
              // adjust Power BI format string as desired
              "format": "#,,0,,.000M"
            },
            "x": {
              "value": 0
            },
            "y": {
              "value": 30
            }
          }
        },
        {
          "name": "FEMALE_BAR",
          "transform": [
            {
              "filter": {
                "field": "_sex",
                "equal": "Female"
              }
            },
            {
              "calculate": "datum['_count'] * -1",
              "as": "_negative_count"
            }
          ],
          "mark": {
            "type": "bar",
            "tooltip": true,
            // for dynamic colours, uncomment, adjust the colour parameters, and adjust the Power BI theme divergent colours as desired
            "color": {
              "expr": "_left_colour_gradient"
            },
            // for hard-coded colours, uncomment and adjust colour HEX codes as desired; 7th and 8th HEX code characters are the transparency
            // "color": {
            //   "x1": 1,
            //   "y1": 0,
            //   "x2": 0,
            //   "y2": 0,
            //   "gradient": "linear",
            //   "stops": [
            //     {
            //       "offset": 0,
            //       "color": "#BB264933"
            //     },
            //     {
            //       "offset": 1,
            //       "color": "#BB2649CC"
            //     }
            //   ]
            // }
            "style": "_population_bar_style"
          },
          "encoding": {
            "y": {
              "field": "_age_group",
              "axis": null,
              "sort": {
                "op": "sum",
                "field": "_age_group_id",
                "order": "descending"
              }
            },
            "x": {
              "field": "_negative_count",
              "type": "quantitative",
              "axis": {
                "title": "Female",
                "labelExpr": "datum.value == 0 ? null : pbiFormat( -1 * datum.value, '#,0,.K' )"
              },
              "scale": {
                "domain": [
                  {
                    "expr": "_negative_group_range_max"
                  },
                  0
                ]
              }
            },
            "tooltip": [
              {
                "field": "_age_group",
                "type": "nominal",
                "title": "__dataset.0__"
              },
              {
                "field": "_count",
                "type": "quantitative",
                "formatType": "pbiFormat",
                // adjust 2-part Power BI format string as desired
                "format": "#,0;#,0",
                "title": "Female Count"
              }
            ]
          }
        }
      ]
    },
    {
      "name": "Y-AXIS",
      "width": 20,
      "height": 600,
      "mark": {
        "type": "text",
        "align": "center",
        "style": "_age_group_text_style"
      },
      "encoding": {
        "y": {
          "field": "_age_group",
          "axis": null,
          "sort": {
            "op": "sum",
            "field": "_age_group_id",
            "order": "descending"
          }
        },
        "text": {
          "field": "_age_group_short",
          "type": "nominal"
        }
      }
    },
    {
      "name": "MALE",
      "width": 400,
      "height": 600,
      "transform": [
        {
          "filter": {
            "field": "_sex",
            "equal": "Male"
          }
        },
        {
          "calculate": "datum['_count'] * 1",
          "as": "_count"
        }
      ],
      "mark": {
        "type": "bar",
        "tooltip": true,
        // for dynamic colours, uncomment, adjust the colour parameters, and adjust the Power BI theme divergent colours as desired
        "color": {
          "expr": "_right_colour_gradient"
        },
        // for hard-coded colours, uncomment and adjust colour HEX codes as desired; 7th and 8th HEX code characters are the transparency
        // "color": {
        //   "x1": 0,
        //   "y1": 1,
        //   "x2": 1,
        //   "y2": 1,
        //   "gradient": "linear",
        //   "stops": [
        //     {
        //       "offset": 0,
        //       "color": "#35558A33"
        //     },
        //     {
        //       "offset": 1,
        //       "color": "#35558ACC"
        //     }
        //   ]
        // }
        "style": "_population_bar_style"
      },
      "encoding": {
        "y": {
          "field": "_age_group",
          "axis": null,
          "sort": {
            "op": "sum",
            "field": "_age_group_id",
            "order": "descending"
          }
        },
        "x": {
          "aggregate": "sum",
          "field": "_count",
          "type": "quantitative",
          "axis": {
            "title": "Male",
            "labelExpr": "datum.value == 0 ? null : pbiFormat( datum.value, '#,0,.K' )"
          },
          "scale": {
            "domain": [
              0,
              {
                "expr": "_positive_group_range_max"
              }
            ]
          }
        },
        "tooltip": [
          {
            "field": "_age_group",
            "type": "nominal",
            "title": "__dataset.0__"
          },
          {
            "field": "__dataset.4__",
            "type": "quantitative",
            "formatType": "pbiFormat",
            // adjust 2-part Power BI format string as desired
            "format": "#,0;#,0",
            "title": "Male Count"
          }
        ]
      }
    }
  ]
