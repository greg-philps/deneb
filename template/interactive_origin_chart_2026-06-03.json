  "title": {
    "anchor": "start",
    "align": "left",
    "text": "Deneb Interactive Origin Chart",
    "subtitle": [
      "Market Index Percent Performance by Date",
      "Data Source: Investing.com, 2026-05-28",
      "URL: https://ca.investing.com/indices/major-indices"
    ],
    "offset": 60
  },
  // standard Power BI dataset
  "data": {
    "name": "dataset",
    "format": {
      "parse": {
        "date": "__1__"
      }
    }
  },
  "width": 800,
  // "height": 380,
  "transform": [
    // assign dev id to help identify dataset in data pane
    {
      "calculate": "1",
      "as": "_DEV_ID"
    },
    {
      "joinaggregate": [
        {
          "op": "mean",
          "field": "__1__",
          "as": "_mean_date"
        }
      ]
    },
    {
      "calculate": "datetime( datum['_mean_date'] )",
      "as": "_threshold_date"
    }
  ],
  "layer": [
    {
      "name": "ORIGIN_POINT_HIDDEN",
      "params": [
        {
          "name": "_origin",
          "value": [
            {
              "x": {
                "year": 2025,
                "month": 1,
                "date": 1
              }
            }
          ],
          "select": {
            "type": "point",
            "encodings": [
              "x"
            ],
            "on": "mouseover",
            "nearest": true
          }
        }
      ],
      "mark": {
        "type": "point"
      },
      "encoding": {
        "x": {
          "field": "__1__",
          "type": "temporal"
        },
        "opacity": {
          "value": 0
        }
      }
    },
    {
      "layer": [
        {
          "name": "STOCK_LINES",
          "transform": [
            {
              "lookup": "__0__",
              "from": {
                "param": "_origin",
                "key": "__0__"
              }
            },
            {
              "calculate": "datum._origin && datum._origin['Price'] > 0 ? (datum['__2__'] - datum._origin['Price'])/datum._origin['Price'] : 0",
              "as": "_indexed_price"
            }
          ],
          "mark": {
            "type": "line"
          },
          "encoding": {
            "x": {
              "field": "__1__",
              "type": "temporal"
            },
            "y": {
              "field": "_indexed_price",
              "type": "quantitative",
              "axis": {
                "title": "Percent Variance",
                "format": "%"
              }
            },
            "color": {
              "field": "__0__",
              "type": "nominal",
              // hard-coded colours
              "scale": {
                "domain": [
                  "TSX",
                  "CAC 40",
                  "FTSE 100",
                  "DAX",
                  "Nikkei 225"
                ],
                "range": [
                  "#4A4A4A", // black
                  "#0000FF", // green
                  "#00FF00", // red
                  "#FF0000", // blue
                  "#969696" // grey
                ]
              },
              // // Deneb's built-in use of the current Power BI theme colours
              // "scale": {
              //   "scheme": "pbiColorNominal"
              // },
              "legend": {
                "orient": "none",
                "direction": "horizontal",
                "legendX": -44,
                "legendY": -44,
                "title": null
              }
            }
          }
        },
        {
          "name": "ORIGIN_VERTICAL_RULE_AND_TEXT",
          "transform": [
            {
              "filter": {
                "param": "_origin"
              }
            }
          ],
          "encoding": {
            "x": {
              "field": "__1__",
              "type": "temporal"
            }
          },
          "layer": [
            {
              "name": "ORIGIN_RULE",
              "mark": {
                "type": "rule",
                "style": "_origin_rule_style"
              }
            },
            {
              "name": "ORIGIN_TEXT",
              "mark": {
                "type": "text",
                "align": {
                  "expr": "datum['__1__'] > datum['_threshold_date'] ? 'right' : 'left'"
                },
                "xOffset": {
                  "expr": "datum['__1__'] > datum['_threshold_date'] ? -8 : 8"
                },
                "style": "_origin_text_style"
              },
              "encoding": {
                "text": {
                  "field": "__1__",
                  "timeUnit": "yearmonthdate"
                },
                "y": {
                  "value": 8
                }
              }
            }
          ]
        }
      ]
    }
  ]
