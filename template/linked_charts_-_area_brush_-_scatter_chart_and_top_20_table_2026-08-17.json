  /*
  "usermeta": {
    "title": "Deneb Linked Charts - Area Brush",
    "author": "Greg Philps",
    "date": "2026-08-17",
    "deneb version": "1.9.1",
    "power bi desktop version": "2.156.951",
    "description": "Two linked charts (scatter chart showing the selected players where an area brush can be used to select a subset of players and their statistics in a top 20 table)",
    "notes": "The first ranked in each statistic is highlighted",
    "template notes": "usermeta object is used by the Deneb template generation process and is thus overwritten, hence added here as a comment"
  },
