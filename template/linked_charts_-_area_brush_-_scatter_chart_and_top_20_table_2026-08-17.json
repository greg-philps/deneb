  "title": {
    "offset": 20,
    "anchor": "start",
    "align": "left",
    "text": "Deneb Linked Charts - Area Brush",
    "font": "Segoe UI",
    "fontSize": 24,
    "fontWeight": "bold",
    "fontStyle": "italic",
    "color": "#4A4A4A",
    "subtitle": [
      "Scatter Chart and Top 20 Table",
      "Football Statistics - 2025-2026"
    ],
    "subtitleFont": "Segoe UI",
    "subtitleFontSize": 16,
    "subtitleFontWeight": "normal",
    "subtitleFontStyle": "italic",
    "subtitleColor": "#4A4A4A"
  },
  // standard Power BI dataset
  "data": {
    "name": "dataset"
  },
  "transform": [
    // restrict dataset to only those players with >=5 goals and >= 45 average minutes
    {
      "filter": "datum['__4__'] >= 5 && datum['__3__'] >= 45"
    },
    // prefix the position with an order
    {
      "calculate": "[ 'Forward', 'Midfielder', 'Defender', 'Goalkeeper' ]",
      "as": "_position_array"
    },
    {
      "calculate": "indexof( datum['_position_array'], datum['__2__'] ) + '-' + datum['__2__']",
      "as": "_combined_position"
    }
  ],
  "params": [
    {
      "name": "_highlight_colour",
      "value": "#0CA181"
    }
  ],
  "vconcat": [
    {
      "name": "DIVIDER",
      "width": 1230,
      "height": 2,
      "data": {
        "values": [
          {
            "y_width": 100
          }
        ]
      },
      "mark": {
        "type": "rule",
        "color": "#969696",
        "strokeWidth": 2
      },
      "encoding": {
        "y": {
          "field": "y_width",
          "type": "quantitative",
          "axis": null
        }
      }
    },
    {
      "hconcat": [
        {
          "name": "SCATTER",
          "width": 500,
          "height": 500,
          "title": {
            "offset": 40,
            "anchor": "middle",
            "text": "Goals vs. Average Minutes",
            "subtitle": "(>= 5 goals and >= 45 minutes)"
          },
          "encoding": {
            "x": {
              "field": "__4__",
              "type": "quantitative",
              "axis": {
                "grid": true,
                "labelFontSize": 12
              },
              "scale": {
                "domain": [
                  0,
                  40
                ]
              }
            },
            "y": {
              "field": "__3__",
              "type": "quantitative",
              "axis": {
                "grid": true,
                "labelFontSize": 12
              },
              "scale": {
                "domain": [
                  40,
                  100
                ]
              }
            }
          },
          "layer": [
            {
              "name": "SYMBOL",
              "params": [
                {
                  "name": "_brush",
                  "select": "interval"
                }
              ],
              "mark": {
                "type": "point",
                "size": 200,
                "filled": true,
                "tooltip": true
              },
              "encoding": {
                "color": {
                  "field": "_combined_position",
                  "type": "nominal",
                  "legend": {
                    "orient": "bottom",
                    "symbolSize": 300,
                    "title": "__2__",
                    "labelExpr": "slice( datum.value, 2, 100 )"
                  }
                },
                "shape": {
                  "field": "_combined_position",
                  "type": "nominal"
                },
                "tooltip": [
                  {
                    "field": "__0__",
                    "type": "nominal"
                  },
                  {
                    "field": "__1__",
                    "type": "nominal"
                  },
                  {
                    "field": "__3__",
                    "type": "quantitative",
                    "title": "Avg. Min."
                  },
                  {
                    "field": "__4__",
                    "type": "quantitative"
                  },
                  {
                    "field": "__8__",
                    "type": "quantitative"
                  },
                  {
                    "field": "__6__",
                    "type": "quantitative"
                  },
                  {
                    "field": "__5__",
                    "type": "quantitative",
                    "title": "Yellows"
                  }
                ]
              }
            },
            {
              "name": "NAME",
              "mark": {
                "type": "text",
                "align": "left",
                "xOffset": 10,
                "color": "black"
              },
              "encoding": {
                "text": {
                  "field": "__0__",
                  "type": "nominal"
                }
              }
            }
          ]
        },
        {
          "name": "TOP_20_TABLE",
          "width": 600,
          "height": {
            "step": 20
          },
          "title": {
            "anchor": "middle",
            "text": "Player Statistics",
            "subtitle": "(leaders highlighted)"
          },
          "transform": [
            {
              "filter": {
                "param": "_brush"
              }
            },
            {
              "window": [
                {
                  "op": "rank",
                  "as": "_id_rank"
                }
              ],
              "sort": [
                {
                  "field": "__7__",
                  "order": "descending"
                }
              ]
            },
            {
              "filter": "datum['_id_rank'] <= 20"
            },
            {
              "window": [
                {
                  "op": "rank",
                  "as": "_goals_rank"
                }
              ],
              "sort": [
                {
                  "field": "__4__",
                  "order": "descending"
                }
              ]
            },
            {
              "window": [
                {
                  "op": "rank",
                  "as": "_shots_rank"
                }
              ],
              "sort": [
                {
                  "field": "__8__",
                  "order": "descending"
                }
              ]
            },
            {
              "window": [
                {
                  "op": "rank",
                  "as": "_yellows_rank"
                }
              ],
              "sort": [
                {
                  "field": "__5__",
                  "order": "descending"
                }
              ]
            },
            {
              "window": [
                {
                  "op": "rank",
                  "as": "_assists_rank"
                }
              ],
              "sort": [
                {
                  "field": "__6__",
                  "order": "descending"
                }
              ]
            },
            {
              "window": [
                {
                  "op": "rank",
                  "as": "_minutes_rank"
                }
              ],
              "sort": [
                {
                  "field": "__3__",
                  "order": "descending"
                }
              ]
            },
            {
              "fold": [
                "__4__",
                "__8__",
                "__5__",
                "__6__",
                "__3__"
              ]
            }
          ],
          "encoding": {
            "x": {
              "field": "key",
              "type": "nominal",
              "axis": {
                "labelAngle": 0,
                "orient": "top",
                "labelFontSize": 12
              },
              "title": "Statistic",
              "scale": {
                "padding": 0.05
              },
              "sort": null
            },
            "y": {
              "field": "__0__",
              "type": "ordinal",
              "axis": {
                "labelFontSize": 12
              },
              "title": "Player",
              "scale": {
                "padding": 0.05
              },
              "sort": {
                "op": "sum",
                "field": "__0__",
                "order": "ascending"
              }
            }
          },
          "layer": [
            {
              "mark": {
                "type": "rect",
                "style": "_rect_style"
              },
              "encoding": {
                "color": {
                  "condition": [
                    {
                      "test": "datum['key'] == 'Goals' && datum['_goals_rank'] == 1",
                      "value": {
                        "expr": "_highlight_colour"
                      }
                    },
                    {
                      "test": "datum['key'] == 'Shots' && datum['_shots_rank'] == 1",
                      "value": {
                        "expr": "_highlight_colour"
                      }
                    },
                    {
                      "test": "datum['key'] == 'Yellow Cards' && datum['_yellows_rank'] == 1",
                      "value": {
                        "expr": "_highlight_colour"
                      }
                    },
                    {
                      "test": "datum['key'] == 'Assists' && datum['_assists_rank'] == 1",
                      "value": {
                        "expr": "_highlight_colour"
                      }
                    },
                    {
                      "test": "datum['key'] == 'Average Minutes' && datum['_minutes_rank'] == 1",
                      "value": {
                        "expr": "_highlight_colour"
                      }
                    }
                  ],
                  "value": "#E3E3E3"
                }
              }
            },
            {
              "mark": {
                "type": "text",
                "color": "black",
                "fontWeight": "bold"
              },
              "encoding": {
                "text": {
                  "field": "value"
                }
              }
            }
          ]
        }
      ]
    }
  ]
}