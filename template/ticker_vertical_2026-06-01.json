  /*
  "usermeta": {
    "title": "Deneb Ticker - Vertical",
    "author": "Greg Philps",
    "date": "2026-06-01",
    "deneb version": "1.9.1",
    "power bi desktop version": "2.154.1260.0",
    "description": "A vertical ticker switching notes every 2 seconds",
    "notes": "adjust switch interval as desired",
    "template notes": "usermeta object is used by the Deneb template generation process and is thus overwritten, hence added here as a comment"
  },
  */
  "data": {
    "name": "dataset"
  },
  "transform": [
    // assign internal field to identify dataset
    {
      "calculate": "1",
      "as": "_DEV_ID"
    },
    // assign internal names to dataset fields
    {
      "calculate": "datum['__0__']",
      "as": "_id"
    },
    {
      "calculate": "datum['__1__']",
      "as": "_note"
    },
    // adjust the item display seconds as desired
    {
      "calculate": "2",
      "as": "_item_seconds"
    },
    // determine how many items
    {
      "joinaggregate": [
        {
          "op": "count",
          "field": "_id",
          "as": "_item_count"
        }
      ]
    },
    // determine the row number to display
    {
      "calculate": "datum['_item_count'] * datum['_item_seconds']",
      "as": "_cycle_seconds"
    },
    {
      "calculate": "floor( ( _elapsed_seconds / datum['_cycle_seconds'] ) - 0.001 ) + 1",
      "as": "_cycle_number"
    },
    {
      "calculate": "floor( ( ( _elapsed_seconds / datum['_cycle_seconds']  ) * datum['_item_count'] ) - 0.001 ) - (datum['_item_count'] * ( datum['_cycle_number'] - 1 ) )",
      "as": "_row_number"
    },
    // always return only the desired single record
    {
      "filter": "datum['__row__'] == datum['_row_number']"
    }
  ],
  "params": [
    // create timer and calculate elapsed time
    {
      "name": "_current_time",
      "value": "now()",
      "on": [
        {
          "events": {
            "type": "timer",
            "throttle": 10 // milliseconds
          },
          "update": "now()"
        }
      ]
    },
    {
      "name": "_start_time",
      "init": "now()"
    },
    {
      "name": "_elapsed_ms",
      "expr": "_current_time - _start_time"
    },
    {
      "name": "_elapsed_seconds",
      "expr": "seconds( _elapsed_ms )"
    }
  ],
  "encoding": {
    "x": {
      "type": "quantitative",
      "axis": null,
      "scale": {
        "domain": [
          0,
          100
        ]
      }
    },
    "y": {
      "type": "quantitative",
      "axis": {
