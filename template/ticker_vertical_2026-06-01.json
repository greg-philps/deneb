        "ticks": false,
        "domain": false,
        "grid": false
      },
      "scale": {
        "domain": [
          0,
          10
        ]
      }
    }
  },
  "layer": [
    {
      "name": "BACKGROUND_BAR",
      "mark": {
        "type": "bar",
        "style": "_ticker_bar_style"
      },
      "encoding": {
        "x": {
          "datum": 0
        },
        "x2": {
          "datum": 100
        },
        "y": {
          "datum": 0
        },
        "y2": {
          "datum": 10
        }
      }
    },
    {
      "name": "NOTE",
      "mark": {
        "type": "text",
        "align": "left",
        "baseline": "middle",
        // option 1: value - adjust as desired to set the static max text length in pixels
        // option 2: expression - use "width" to set dynamic max length in pixels
        // use [limit] to set the maximum length of the text mark in pixels. The text value will be automatically truncated if the rendered size exceeds the limit.
        "limit": {
          "expr": "width-30"
        },
        // use [ellipsis] to set the string for text truncated in response to the limit parameter.
        "ellipsis": "...",
        "style": "_note_text_style"
      },
      "encoding": {
        "text": {
          "field": "_note",
          "type": "nominal"
        },
        "x": {
          "datum": 2
        },
        "y": {
          "datum": 5
        }
      }
    }
  ]
}