              },
              "value": [
                2,
                2
              ]
            },
            "title": "__0__"
          }
        },
        "y": {
          "field": "_daily_value",
          "type": "quantitative",
          "axis": {
            "tickCount": 10,
            "title": "Value"
          }
        }
      }
    },
    {
      "name": "DETAIL",
      "width": 1100,
      "height": 340,
