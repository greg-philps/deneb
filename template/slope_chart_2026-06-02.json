      "calculate": "datum['__1__']",
      "as": "_position"
    },
    {
      "calculate": "datum['__2__']",
      "as": "_team"
    },
    // get the maximum season
    {
      "joinaggregate": [
        {
          "op": "max",
          "field": "_season",
          "as": "_max_season"
        }
      ]
    },
