  /*
  "usermeta": {
    "title": "Deneb Thermometer Gauge",
    "author": "Greg Philps",
    "date": "2026-05-01",
    "deneb version": "1.9.1",
    "power bi desktop version": "2.153.910.0",
    "description": "A bulb-and-gauge visual with temperature-dependent 4-colour fill using Power BI theme colours",
    "notes": "uses a dataset-based scale scale",
    "template notes": "usermeta object is used by the Deneb template generation process and is thus overwritten, hence added here as a comment"
  },
  */
  // text and position only; formatting done in "config\title"
  "title": {
    "anchor": "start",
    "align": "left",
    "text": "Deneb Thermometer Gauge"
  },
  // set the visual size to fill the Power BI container
  "width": "container",
  "height": "container",
  // standard Power BI dataset
  "data": {
    "name": "dataset"
  },
  "transform": [
    // use an internal development ID for easy dataset identification
    {
      "calculate": "1",
      "as": "_DEV_ID"
    },
    // assign internal names to dataset fields
    {
      "calculate": "datum['__0__']",
      "as": "_id"
    },
    {
      "calculate": "datum['__1__']",
      "as": "_range"
    },
    {
      "calculate": "datum['__2__']",
      "as": "_range_min"
    },
    {
      "calculate": "datum['__3__']",
      "as": "_range_max"
    },
    {
      "calculate": "datum['__4__']",
      "as": "_temperature"
    },
    {
      "joinaggregate": [
        {
          "op": "min",
          "field": "_range_min",
          "as": "_min_scale"
        },
        {
          "op": "max",
          "field": "_range_max",
          "as": "_max_scale"
        }
      ]
    },
    {
      "calculate": "if( datum['_temperature'] >= datum['_range_min'] && datum['_temperature'] <= datum['_range_max'], datum['_range'] == 'Freezing' ? pbiColor(1) : datum['_range'] == 'Cold' ? pbiColor(3) : datum['_range'] == 'Nice' ? pbiColor(5) : datum['_range'] == 'Hot' ? pbiColor(7) : null, null )",
      "as": "_gauge_colour"
    },
    {
      "calculate": "datum['_max_scale'] - datum['_min_scale']",
      "as": "range_scale"
    },
    {
      "calculate": "datum['_min_scale'] - 6",
      "as": "_bulb_center"
    },
    {
      "filter": "datum['_gauge_colour'] != null"
    }
  ],
  "params": [
    // adjust border width and colour as desired
    {
      "name": "_border_width",
      "value": 10
    },
    {
      "name": "_border_color",
      "value": "#E3E3E3"
    }
  ],
  // shared encoding
  "encoding": {
    "y": {
      "type": "quantitative",
      "axis": {
        "title": null
      }
    }
  },
  "layer": [
    {
      "name": "GAUGE_BORDER",
      "mark": {
        "type": "bar",
        "width": 60,
        "filled": false,
        "stroke": {
          "expr": "_border_color"
        },
        "strokeWidth": {
          "expr": "_border_width"
        },
        "cornerRadiusTopLeft": 1,
        "cornerRadiusTopRight": 1
      },
      "encoding": {
        "y": {
          "field": "_min_scale"
        },
        "y2": {
          "field": "_max_scale"
        }
      }
    },
    {
      "name": "BULB_FILL",
      "mark": {
        "type": "circle",
        "size": 10000,
        "stroke": {
          "expr": "_border_color"
        },
        "strokeWidth": {
          "expr": "_border_width"
        },
        "color": {
          "expr": "datum['_gauge_colour']"
        },
        "opacity": 1
      },
      "encoding": {
        "y": {
          "field": "_bulb_center"
        }
      }
    },
    {
      "name": "GAUGE_FILL",
      "mark": {
        "type": "bar",
        "width": 50,
        "color": {
          "expr": "datum['_gauge_colour']"
        }
      },
      "encoding": {
        "y": {
          "field": "_min_scale"
        },
        "y2": {
          "field": "_temperature"
        }
      }
    },
    {
      "name": "TEMPERATURE",
      "mark": {
        "type": "text",
        "baseline": "top", // top, middle, bottom
        "yOffset": 4,
        "style": "_temperature_text_style"
      },
      "encoding": {
        "text": {
          "field": "_temperature",
          "type": "quantitative",
          "formatType": "pbiFormat",
          "format": "#"
        },
        "y": {
          "field": "__4__"
        }
      }
    }
  ]
