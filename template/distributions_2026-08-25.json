  "title": {
    "anchor": "start",
    "align": "left",
    "text": "Deneb Distributions",
    "subtitle": [
      "Histogram (20-bin column chart; background)",
      "Normal Distribution (semi-transparent area chart; adjustable with screen widgets; foreground)"
    ],
    "offset": 20
  },
  // standard Power BI dataset
  "data": {
    "name": "dataset"
  },
  "transform": [
    // assign internal names to dataset fields
    {
      "calculate": "datum['__0__']",
      "as": "_name"
    },
    {
      "calculate": "datum['__1__']",
      "as": "_value"
    }
  ],
  // screen widgets
  "params": [
    {
      "name": "_normal_height_coefficient",
      "value": 230,
      "bind": {
        "input": "range",
        "min": 0,
        "max": 800,
        "step": 10,
        "name": "Height Coeff: "
        // "fontColor": "red"
      }
    },
    {
      "name": "_normal_mean",
      "value": 5,
      "bind": {
        "input": "range",
        "min": 0,
        "max": 10,
        "step": 0.5,
        "name": "Mean: "
      }
    },
    {
      "name": "_normal_std_dev",
      "value": 1,
      "bind": {
        "input": "range",
        "min": 0,
        "max": 3,
        "step": 0.5,
        "name": "Std Dev: "
      }
    }
  ],
  "layer": [
    {
      "name": "HISTOGRAM",
      "width": 760,
      "height": 700,
      "mark": {
        "type": "bar",
        "cornerRadiusEnd": 20,
        // adjust Power BI theme colour as desired
        "color": {
          "expr": "pbiColor(0)"
        },
        "tooltip": true
      },
      "encoding": {
        "x": {
          "bin": {
            "maxbins": 20,
            // include the [extent] array to define the full range of bins, not only those with data
            "extent": [
              0,
              10
            ]
          },
          "field": "_value",
          "type": "quantitative",
          "axis": {
            "title": "__1__" // adjust to suit dataset
          }
        },
        "y": {
          "aggregate": "count",
          "axis": {
            "title": "Count"
          }
        }
      }
    },
    {
      "name": "NORMAL_DISTRIBUTION",
      "data": {
        "sequence": {
          "start": 0,
          "stop": 10,
          "step": 0.1,
          "as": "_x_normal"
        }
      },
      "transform": [
        {
          "calculate": "densityNormal( datum['_x_normal'], _normal_mean, _normal_std_dev )",
          "as": "_y_base"
        },
        {
          "calculate": "2.5 * _normal_height_coefficient",
          "as": "_y_factor"
        },
        {
          "calculate": "datum['_y_base'] * datum['_y_factor']",
          "as": "_y_normal"
        }
      ],
      "mark": {
        "type": "area",
        // adjust normal distribution colour as desired
        "color": "#454545",
        "opacity": 0.2
      },
      "encoding": {
        "x": {
          "field": "_x_normal",
          "type": "quantitative"
        },
        "y": {
          "field": "_y_normal",
          "type": "quantitative"
        }
      }
    }
  ]
}