  /*
  "usermeta": {
    "title": "Deneb Ticker - Horizontal",
    "author": "Greg Philps",
    "date": "2026-06-01",
    "deneb version": "1.9.1",
    "power bi desktop version": "2.154.1260.0",
    "description": "A horizontal ticker scrolling notes every tenth of a  second",
    "notes": "adjust scroll interval as desired; adjust number of times the series of notes is displayed as desired",
    "template notes": "usermeta object is used by the Deneb template generation process and is thus overwritten, hence added here as a comment"
  },
  */
  "data": {
    "name": "dataset"
  },
  "transform": [
    // assign internal field to identify dataset
    {
      "calculate": "1",
      "as": "_DEV_ID"
    },
    // assign internal names to dataset fields
    {
      "calculate": "datum['__0__']",
      "as": "_id"
    },
    {
      "calculate": "datum['__1__']",
      "as": "_note"
    },
    {
      "calculate": "if( datum['_id'] == 1, datum['_note'], null )",
      "as": "_note_1"
    },
    {
      "calculate": "if( datum['_id'] == 2, datum['_note'], null )",
      "as": "_note_2"
    },
    {
      "calculate": "if( datum['_id'] == 3, datum['_note'], null )",
      "as": "_note_3"
    },
    {
      "calculate": "if( datum['_id'] == 4, datum['_note'], null )",
      "as": "_note_4"
    },
    {
      "calculate": "if( datum['_id'] == 5, datum['_note'], null )",
      "as": "_note_5"
    },
    {
      "calculate": "if( datum['_id'] == 6, datum['_note'], null )",
      "as": "_note_6"
    },
    {
      "calculate": "if( datum['_id'] == 7, datum['_note'], null )",
      "as": "_note_7"
    },
    {
      "calculate": "if( datum['_id'] == 8, datum['_note'], null )",
      "as": "_note_8"
    },
    {
      "calculate": "if( datum['_id'] == 9, datum['_note'], null )",
      "as": "_note_9"
    },
    {
      "calculate": "if( datum['_id'] == 10, datum['_note'], null )",
      "as": "_note_10"
    },
    {
      "joinaggregate": [
        {
          "op": "max",
          "field": "_note_1",
          "as": "_n1"
        },
        {
          "op": "max",
          "field": "_note_2",
          "as": "_n2"
        },
        {
          "op": "max",
          "field": "_note_3",
          "as": "_n3"
        },
        {
          "op": "max",
          "field": "_note_4",
          "as": "_n4"
        },
        {
          "op": "max",
          "field": "_note_5",
          "as": "_n5"
        },
        {
          "op": "max",
          "field": "_note_6",
          "as": "_n6"
        },
        {
          "op": "max",
          "field": "_note_7",
          "as": "_n7"
        },
        {
          "op": "max",
          "field": "_note_8",
          "as": "_n8"
        },
        {
          "op": "max",
          "field": "_note_9",
          "as": "_n9"
        },
        {
          "op": "max",
          "field": "_note_10",
          "as": "_n10"
        }
      ]
    },
    {
      "filter": "datum['__row__'] == 0"
    },
    // compose a single string with all notes
    {
      "calculate": "if( isValid( datum['_n1'] ), datum['_n1'] + _sep, '' ) + if( isValid( datum['_n2'] ), datum['_n2'] + _sep, '' ) + if( isValid( datum['_n3'] ), datum['_n3'] + _sep, '' ) + if( isValid( datum['_n4'] ), datum['_n4'] + _sep, '' ) + if( isValid( datum['_n5'] ), datum['_n5'] + _sep, '' ) + if( isValid( datum['_n6'] ), datum['_n6'] + _sep, '' ) + if( isValid( datum['_n7'] ), datum['_n7'] + _sep, '' ) + if( isValid( datum['_n8'] ), datum['_n8'] + _sep, '' ) + if( isValid( datum['_n9'] ), datum['_n9'] + _sep, '' ) + if( isValid( datum['_n10'] ), datum['_n10'] + _sep, '' )",
      "as": "_all_notes"
    },
    // strip final separator
    {
      "calculate": "slice( datum['_all_notes'], 0, length( datum['_all_notes'] ) - 3 )",
      "as": "_all_notes"
    },
    // concatenate the string 5x
    {
      "calculate": "_start_sep + datum['_all_notes'] + _start_sep + datum['_all_notes'] + _start_sep + datum['_all_notes'] + _start_sep + datum['_all_notes'] + _start_sep + datum['_all_notes']",
      "as": "_5x_notes"
    }
  ],
  "params": [
    // create timer and calculate elapsed time
    {
      "name": "_current_time",
      "value": "now()",
      "on": [
        {
          "events": {
            "type": "timer",
            "throttle": 10 // milliseconds
          },
          "update": "now()"
        }
      ]
    },
    {
      "name": "_start_time",
      "init": "now()"
    },
    {
      "name": "_elapsed_ms",
      "expr": "_current_time - _start_time"
    },
    {
      "name": "_elapsed_tenths_of_seconds",
      "expr": "_elapsed_ms / 10"
    },
    {
      "name": "_elapsed_seconds",
      "expr": "seconds( _elapsed_ms )"
    },
    {
      "name": "_sep",
      "expr": "' ' + '\u2022' + ' '"
    },
    // adjust unicode character as desired
    // \u2588 = filled square (large)
    // \u21D4 = double-headed block arrow
    // \u2591 = dotted square (sparse)
    // \u2692 = dotted square (dense)
    {
      "name": "_start_sep",
      "expr": "' ' + '\u2591' + ' '"
    }
  ],
  "encoding": {
    "x": {
      "type": "quantitative",
      "axis": null,
      "scale": {
        "domain": [
          0,
          100
        ]
      }
