        "align": "left",
        "baseline": "middle",
        "clip": true,
        // *** FIX - ADJUST TO USE ELAPSED TIME ***
        // "xOffset": -80,
        "xOffset": {
          "expr": "_elapsed_tenths_of_seconds * -1"
        },
        "style": "_note_text_style"
      },
      "encoding": {
        "text": {
          "field": "_5x_notes",
          "type": "nominal"
        },
        // "opacity": {
        //   "field": "_opacity",
        //   "type": "quantitative",
        //   "legend": null
        // },
        "x": {
          "datum": 2
        },
        "y": {
          "datum": 5
        }
      }
    }
  ]
}