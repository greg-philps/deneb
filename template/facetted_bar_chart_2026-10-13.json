  /*
  "usermeta": {
    "title": "Deneb Facetted Bar Chart",
    "author": "Greg Philps",
    "date": "2026-10-13",
    "deneb version": "2.0.0",
    "power bi desktop version": "2.158.1304.0",
    "description": "A facetted bar chart that can enhance the visualization and interpretation of insights from data subsets. Similar to a matrix, the visual displays value by category by period (in this example, electric vehicle new car sales rate by country by year). The bars are coloured with Power BI theme colour 1.",
    "notes": "a screen widget provides interactivity and allows the user to select the desired sort order (by name or by rank)",
    "template notes": "usermeta object is used by the Deneb template generation process and is thus overwritten, hence added here as a comment"
  },
  */
  "title": {
    "anchor": "start",
    "align": "left",
    "orient": "top",
    "offset": 20,
    "text": "Deneb Facetted Bar Chart",
    "subtitle": [
      "Value by Category by Period",
      "(Electric Vehicle New Car Sales Rate by Country by Year)",
      "Data Source: International Energy Agency Global EV Outlook 2026",
      "https://www.iea.org/data-and-statistics/data-product/global-ev-outlook-2026"
    ]
  },
  // standard Power BI dataset
  "data": {
    "name": "dataset"
  },
  "spacing": 5,
  "transform": [
    // assign internal field names to dataset fields
    {
      "calculate": "datum['__dataset.0__']",
      "as": "_category"
    },
    {
      "calculate": "datum['__dataset.1__']",
      "as": "_period"
    },
    {
      "calculate": "datum['__dataset.2__']",
      "as": "_value"
    },
    // restrict the dataset to specific periods
    {
      "filter": {
        "field": "_period",
        "oneOf": [
          2011,
          2015,
          2020,
          2021,
          2022,
          2023,
          2024,
          2025
        ]
      }
    },
    // calculate percent as a decimal
    {
      "calculate": "datum['_value'] / 100",
      "as": "_value_percent"
    },
    // rank the categories (countries) by name
    {
      "window": [
        {
          "op": "rank",
          "as": "_category_name_rank"
        }
      ],
      "sort": [
        {
          "field": "_category",
          "order": "ascending"
        }
      ]
    },
    // rank the categories (countries) by last period (2025) Value
    {
      "window": [
        {
          "op": "rank",
          "as": "_category_value_rank"
        }
      ],
      "groupby": [
        "_period"
      ],
      "sort": [
        {
          "field": "_value",
          "order": "descending"
        }
      ]
    },
    {
      "joinaggregate": [
        {
          "op": "min",
          "field": "_category_value_rank",
          "as": "_min_category_last_period_rank"
        }
      ],
      "groupby": [
        "_category"
      ]
    },
    {
      "calculate": "_category_sort == 'Name' ? datum['_category_name_rank'] : datum['_min_category_last_period_rank']",
      "as": "_category_display_rank"
    },
    // compose composite label
    {
      "calculate": "( pad( datum['_category_display_rank'], 3, '0', 'left' ) + '-' + datum['_category'] )",
      "as": "_composite_category_label"
    }
  ],
  "params": [
    {
      "name": "_category_sort",
      "value": "Rank",
      "bind": {
        "input": "radio",
        "options": [
          "Name",
          "Rank"
        ],
        // adjust parameter display name to suit dataset
        "name": "Country Sort: "
      }
    }
  ],
  "facet": {
    "column": {
      "field": "_period",
      // disable the facet title
      "title": null
    }
  },
  "spec": {
    // adjust size to suit dataset and visual
    "width": 125,
    "height": 610,
    "layer": [
      {
        "name": "CELL_BORDER",
        "mark": {
          "type": "bar",
          "fill": null, // turn off fill
          "style": "_cell_border_style"
        },
        "encoding": {
          "y": {
            "field": "_composite_category_label",
            "type": "nominal"
          },
          "x": {
            "datum": 1
          }
        }
      },
      {
        "name": "CELL_BAR",
        "mark": {
          "type": "bar",
          "style": "_cell_bar_style"
          // DEV ONLY - REMOVE BEFORE PUBLISHING
          // , "tooltip": { "content": "data" }
        },
        "encoding": {
          "y": {
            "field": "_composite_category_label",
            "type": "nominal",
            "axis": {
              "title": null,
              "labelExpr": "slice( datum.value, 4, 100 )",
              "labelBaseline": "middle",
              "labelPadding": 8
            }
          },
          "x": {
            "field": "_value_percent",
            "type": "quantitative",
            "scale": {
              "domain": [
                0,
                1
              ]
            },
            // only display gridlines at multiples of 25%
            "axis": {
              "title": null,
              "values": [
                0.25,
                0.50,
                0.75
              ]
            }
          }
        }
      },
      {
        "name": "CELL_LABEL",
        "mark": {
          "type": "text",
          "fontWeight": "bold",
          "align": {
            "expr": "datum['_value_percent'] < 0.5 ? 'left' : 'right'"
          },
          "xOffset": {
            "expr": "datum['_value_percent'] < 0.5 ? 4 : -4"
          },
          "color": {
            "expr": "datum['_value_percent'] < 0.01 ? 'transparent' : datum['_value_percent'] < 0.5 ? 'black' : 'white'"
          }
        },
        "encoding": {
          "y": {
            "field": "_composite_category_label",
            "type": "nominal"
          },
          "x": {
            "field": "_value_percent",
            "type": "quantitative"
          },
          "text": {
            "field": "_value_percent",
            "formatType": "pbiFormat",
            // adjust Power BI format string as desired
            "format": "0%"
          }
        }
      }
    ]
  }
}